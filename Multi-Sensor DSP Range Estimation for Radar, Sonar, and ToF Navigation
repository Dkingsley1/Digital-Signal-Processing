            max_range_m=80.0,
            beam_width_deg=7.5,
            noise_std=0.018,
            min_snr_db=11.0,
            description="Pulse-compression radar chirp for medium-range obstacle sensing.",
        ),
        "sonar": SensorConfig(
            name="sonar",
            propagation_speed_mps=SPEED_OF_SOUND_MPS,
            sample_rate_hz=48_000.0,
            waveform="chirp",
            pulse_seconds=0.020,
            bandwidth_hz=16_000.0,
            max_range_m=25.0,
            beam_width_deg=14.0,
            noise_std=0.030,
            min_snr_db=10.0,
            description="Acoustic chirp sonar for short-range navigation and backup sensing.",
        ),
        "tof": SensorConfig(
            name="tof",
            propagation_speed_mps=SPEED_OF_LIGHT_MPS,
            sample_rate_hz=500_000_000.0,
            waveform="gaussian",
            pulse_seconds=40e-9,
            bandwidth_hz=0.0,
            max_range_m=40.0,
            beam_width_deg=4.5,
