#!/usr/bin/env python3
"""
Multi-sensor DSP range estimation for radar, sonar, and optical ToF navigation.

This project simulates emitted waveforms, noisy echoes, matched-filter range
estimation, sensor fusion, and a simple obstacle-avoidance recommendation.
"""

from __future__ import annotations

import argparse
import csv
import math
from dataclasses import dataclass
from pathlib import Path
from typing import Optional

import numpy as np


SPEED_OF_LIGHT_MPS = 299_792_458.0
SPEED_OF_SOUND_MPS = 343.0
EPSILON = 1e-12


@dataclass(frozen=True)
class SensorConfig:
    name: str
    propagation_speed_mps: float
    sample_rate_hz: float
    waveform: str
    pulse_seconds: float
    bandwidth_hz: float
    max_range_m: float
    beam_width_deg: float
    noise_std: float
    min_snr_db: float
    description: str


@dataclass(frozen=True)
class Target:
    x_m: float
    y_m: float
    reflectivity: float
    label: str

    @property
    def range_m(self) -> float:
        return math.hypot(self.x_m, self.y_m)

    @property
    def bearing_deg(self) -> float:
        return math.degrees(math.atan2(self.y_m, self.x_m))


@dataclass
class Detection:
    sensor: str
    bearing_deg: float
    detected: bool
    estimated_range_m: float
    true_range_m: Optional[float]
    range_error_m: Optional[float]
    snr_db: float
    peak_value: float
    x_m: Optional[float]
    y_m: Optional[float]


@dataclass(frozen=True)
class NavigationDecision:
    recommended_bearing_deg: float
    estimated_clearance_m: float
    steering_text: str
    nearest_front_obstacle_m: Optional[float]


